# Copy to .env ON THE SERVER and fill it in. Never commit .env.
APP_ENV=demo                      # demo = demo accounts and the bus simulator; prod = real use (refuses development secrets, the mock gateway)
APP_BASE_URL=https://admin.example.com
# The other subdomain the app is opened from, so writes from it are accepted (comma separated for more).
APP_EXTRA_ORIGINS=https://konduktor.example.com
# Each address is for one role: the right password on the wrong address does not sign in. No spaces, nothing after the value.
HOST_ROLES=admin.example.com=admin,konduktor.example.com=konduktor
LOG_FORMAT=json

# PostgreSQL outside Docker: the host of the dev server's database. If it is the same machine Docker runs on, use host.docker.internal.
DATABASE_URL=postgres://brt_app:CHANGE_ME@DB_HOST:5432/brt_bus_station

# Each at least 32 characters and different: openssl rand -hex 32
SESSION_SECRET=
QR_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=

PAYMENT_PROVIDER=pisopay
PISOPAY_API_USERNAME=
PISOPAY_API_PASSWORD=
PISOPAY_PROCESSOR_NAME=BRTBusStation
PISOPAY_QR_CHANNELS=QR1,QR2,QR3

# Single sign-on from the Smart City app (same value as BRT_SSO_SECRET in the SCE .env)
SSO_ENABLED=true
SSO_SHARED_SECRET=

MAIL_PROVIDER=console
ROUTING_PROVIDER=osrm
BRT_PORT=8080
