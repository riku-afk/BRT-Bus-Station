{
  "name": "brt-bus-station",
  "description": "BRT Bus Station — bus ticketing proof of concept for Cavite bus lines",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "bun run typecheck:client && bun run typecheck:server",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test",
    "db:create": "bun run scripts/db-create.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:fresh": "bun run scripts/migrate.ts --fresh",
    "db:seed": "bun run scripts/seed.ts",
    "db:bootstrap": "bun run scripts/bootstrap-admin.ts",
    "worker:simulator": "bun run scripts/bus-simulator-worker.ts",
    "worker:expire": "bun run scripts/expire-tickets-worker.ts",
    "routes:build": "bun run scripts/build-routes.ts",
    "smoke": "bun run scripts/smoke.ts",
    "workers": "bun run scripts/run-workers.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^1.6.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.16",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.10"
  }
}
