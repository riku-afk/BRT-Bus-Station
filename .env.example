# Copy to .env. Every variable is validated in src/server/config/env.ts.
NODE_ENV=development
APP_ENV=local                  # local | demo | prod
APP_BASE_URL=http://localhost:3000
LOG_FORMAT=pretty              # pretty | json
# Other addresses the app is opened from (comma separated). Writes from them are accepted; any other site is refused.
# APP_EXTRA_ORIGINS=http://localhost:8080

DATABASE_URL=postgres://postgres:password@localhost:5432/brt_bus_station
DATABASE_POOL_MAX=10

# Each at least 32 characters; use different values. Required to be non-default when APP_ENV=prod.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_TTL_HOURS=12
QR_SIGNING_SECRET=dev-only-qr-signing-secret-change-me-0123456789

# Single sign-on from the Smart City app (see plan/sso.md). Off by default.
SSO_ENABLED=true
# SSO_SHARED_SECRET=at-least-32-characters-and-the-same-value-as-the-partner-backend
# SSO_ISSUER=sce
# SSO_AUDIENCE=brt
# SSO_API_AUDIENCE=brt-api
# SSO_MAX_TOKEN_AGE_SECONDS=120

TICKET_PENDING_TTL_MINUTES=15
TICKET_EXPIRY_INTERVAL_SECONDS=30

# mock = offline demo provider; pisopay = PisoPay redirect checkout (see plan/pisopay-setup.md)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret
# Only for PAYMENT_PROVIDER=pisopay. APP_BASE_URL must then be an address PisoPay can reach (it receives the webhook there).
# PISOPAY_BASE_URL=https://api-checkout.pisopay.com.ph
# PISOPAY_API_USERNAME=
# PISOPAY_API_PASSWORD=
# PISOPAY_PROCESSOR_NAME=BRTBusStation

# Email: console = nothing is sent, the app just notes that it would have (works offline); smtp = really send tickets by email.
MAIL_PROVIDER=console
# MAIL_FROM=Cavite Smart Transport Terminal <no-reply@your-domain>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Bus routes: osrm = the real road between shelters (run `bun run routes:build` once, or let the simulator fetch it); none = straight lines.
# The public OSRM demo server is for development only: use your own OSRM or another routing service in production.
ROUTING_PROVIDER=osrm
# OSRM_BASE_URL=https://router.project-osrm.org

# Bus simulator (bun run worker:simulator). The line is ~16 km, so buses move only ~1 px/s on the map at realistic speeds:
# 120 is a good demo speed (use 200+ to see them race). The ETA calculation uses the same speed.
SIM_BUS_COUNT=4
SIM_SPEED_KMH=120
SIM_DWELL_SECONDS=4
SIM_TICK_MS=1000
